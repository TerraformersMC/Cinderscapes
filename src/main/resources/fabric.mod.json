      "environment": "client"
    },
    "mixins.cinderscapes-common.json"
  ],
  "depends": {
    "biolith": ">=3.2.0-",
    "fabricloader": ">=0.18.0",
    "fabric-api": ">=0.144.0",
    "minecraft": ">=26.2 <26.3",
    "java": ">=25",
    "cloth-config": "*"
  }
}
