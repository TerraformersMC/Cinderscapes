{
  "schemaVersion": 1,
  "id": "cinderscapes",
  "version": "${version}",
  "name": "Cinderscapes",
  "description": "An expansion of Minecraft's Nether biomes!",
  "authors": [
    "Vaerian",
    "NeusFear",
    "LudoCrypt",
    "TerraformersMC"
  ],
  "contributors": [
    "SuperCoder79",
    "Prospector",
    "Etorna_Z",
    "Arobazzz",
    "Slice",
    "Trinsdar",
    "haykam821",
    "gniftygnome",
    "FireNH",
    "Fred"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/cinderscapes",
    "sources": "https://github.com/TerraformersMC/Cinderscapes",
    "issues": "https://github.com/TerraformersMC/Cinderscapes/issues"
  },
  "license": "LGPL-3.0-only",
  "icon": "assets/cinderscapes/icon.png",
